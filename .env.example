# ─── Supabase ──────────────────────────────────────────────────────────────
# El MISMO proyecto que usa Celebraloo (Supabase → Project Settings → API).
# URL y llave pública: con ellas el admin inicia sesión con su cuenta normal.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Llave service_role (Supabase → Project Settings → API → secret). SOLO SERVIDOR.
# Se salta RLS: el panel la usa para LEER usuarios, eventos y permisos, siempre
# después de comprobar que quien entra es admin de plataforma. Los cambios de
# permisos NO la usan: van por RPC con la sesión del admin, así quedan auditados
# con su nombre en event_entitlement_grants.
# Nunca le pongas prefijo NEXT_PUBLIC_ ni la subas a git.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Stripe ───────────────────────────────────────────────────────────────
# Promociones: el panel crea Products, Coupons y Promotion Codes. SOLO SERVIDOR.
# Usa una restricted key (rk_test_… / rk_live_…) con permiso de escritura en
# Coupons, Promotion codes y Products, y nada más. Nunca con NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
# Enlaces al dashboard: test (por defecto) o live cuando Celebraloo cobre en producción.
STRIPE_DASHBOARD_MODE=test

# Tarea programada (/api/cron/promociones): activa códigos programados y
# sincroniza usos. Vercel Cron manda "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# ─── Celebraloo ───────────────────────────────────────────────────────────
# URL pública de Celebraloo: el enlace del correo de confirmación que se
# reenvía desde la ficha del cliente apunta aquí (/auth/callback).
CELEBRALOO_APP_URL=https://app.celebraloo.com
